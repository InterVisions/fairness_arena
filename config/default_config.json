{
  "arena": {
    "elo_k_factor": 32,
    "elo_initial_rating": 1500,
    "images_per_model": 12,
    "max_scroll_images": 500,
    "grid_columns": 4,
    "allow_open_queries": false,
    "active_dataset_id": "cfd",
    "judge_question": "",
    "search_query_label": "",
    "show_only_relevant": false,
    "enable_why_tags": true,
    "why_tags": [
      "More gender diverse",
      "More age diverse",
      "More skin tone diverse",
      "Less stereotypical",
      "More relevant images",
      "More natural / realistic",
      "Better overall representation"
    ],
    "matchmaking": "allowed_pairs",
    "allowed_pairs": [
      ["clip-vit-b16", "clip-vit-b16-debiased"],
      ["siglip-b16",   "siglip2-b16"],
      ["clip-vit-b16", "siglip-b16"]
    ]
  },
  "models": [
    {
      "id": "clip-vit-b16",
      "name": "OpenAI CLIP ViT-B/16",
      "backend": "open_clip",
      "model_name": "ViT-B-16",
      "pretrained": "openai",
      "enabled": true
    },
    {
      "id": "clip-vit-b16-debiased",
      "name": "CLIP ViT-B/16 + Neural Interventions",
      "backend": "precomputed",
      "embeddings_file": "embeddings_CFD_debiased.pkl",
      "text_encoder_model": "ViT-B-16",
      "text_encoder_pretrained": "openai",
      "enabled": true
    },
    {
      "id": "siglip-b16",
      "name": "SigLIP ViT-B/16",
      "backend": "open_clip",
      "model_name": "ViT-B-16-SigLIP",
      "pretrained": "webli",
      "enabled": true
    },
    {
      "id": "siglip2-b16",
      "name": "SigLIP2 ViT-B/16",
      "backend": "open_clip",
      "model_name": "ViT-B-16-SigLIP2",
      "pretrained": "webli",
      "enabled": true
    }
  ],
  "datasets": [
    {
      "id": "cfd",
      "name": "Chicago Face Database",
      "source": "folder",
      "folder_path": "/data/datasets/CFD/CFD_balanced50/",
      "max_images": null
    }
  ]
}
